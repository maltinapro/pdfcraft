# Settings for testing purchases locally against the Mollie mock:
#   docker compose --env-file deploy/compose/mock-mollie.env --profile mock up --build
# Then open http://localhost:8080/app/ -> "Buy a token". Not for production.
PAID_TOKENS_ENABLED=true
MOLLIE_API_KEY=test_mock
MOLLIE_API_URL=http://127.0.0.1:9200/v2
# The mock runs in the backend's network namespace, so it reaches the webhook on loopback
PUBLIC_URL=http://127.0.0.1:3000
# Where the browser returns after paying (the app behind the edge proxy)
MOLLIE_REDIRECT_URL=http://localhost:8080/app/
PAID_PRICES=starter:31=2.90,starter:365=24.00
